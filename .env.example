# ---------------------------------------------------------------------------
# Contact form email delivery (Resend)
#
# 1. Create an account at https://resend.com and add an API key below.
# 2. Add and verify the quicctech.io domain under Resend → Domains. Until a
#    domain is verified you can only send from onboarding@resend.dev, and only
#    to the email address the Resend account was registered with — which means
#    the visitor confirmation email will not be delivered.
# 3. Copy this file to `.env.local` and fill in the real values.
# ---------------------------------------------------------------------------

# Required. Resend → API Keys.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where enquiries are delivered. Comma-separate for more than one inbox —
# useful as a safety net if one provider filters the message into junk.
CONTACT_TO_EMAIL=Info@QuiccTech.io,someone@gmail.com

# Sender identity. The domain here must be verified in Resend.
# Before verification, use: Quicc Technologies <onboarding@resend.dev>
CONTACT_FROM_EMAIL="Quicc Technologies <noreply@quicctech.io>"
